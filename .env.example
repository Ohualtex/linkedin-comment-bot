# LinkedIn Generic Search Parameters
# Keywords can be hashtags or regular text, comma-separated (e.g. "#python, #tech, data science")
LINKEDIN_KEYWORDS=#python

# Sort order: "date_posted" (newest first, recommended) or "relevance"
LINKEDIN_SORT_BY=date_posted

# Date filter: "past-24h", "past-week", "past-month"
LINKEDIN_DATE_POSTED=past-week

# Optional direct search URL (if provided, overrides dynamic URL builder)
# LINKEDIN_CUSTOM_SEARCH_URL=https://www.linkedin.com/search/results/content/...

# Path to comment templates text file (one template per line)
TEMPLATES_FILE=./templates.txt

# Directory to store persistent browser session & cookies
BROWSER_USER_DATA_DIR=./session_data

# Headless mode: false recommended for safety and manual verification
HEADLESS=false

# Max posts to comment on per execution run
MAX_COMMENTS_PER_RUN=5

# Delay settings in seconds (min and max jitter between posts)
MIN_DELAY_SECONDS=12
MAX_DELAY_SECONDS=25

# Path to SQLite database for deduplication
DB_PATH=./history.db
